<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              name="CertidaoDebitos" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="municipio" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["SECRETARIA MUNICIPAL DE FINANÇAS"]]></defaultValueExpression>
    </parameter>

    <field name="nomeRazao" class="java.lang.String"/>
    <field name="documento" class="java.lang.String"/> <field name="logradouro" class="java.lang.String"/>
    <field name="bairro" class="java.lang.String"/>
    <field name="cidade" class="java.lang.String"/>
    <field name="codigoAutenticidade" class="java.lang.String"/>

    <title>
        <band height="120">
            <staticText>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="12"/>
                </textElement>
                <text><![CDATA[ÁGAPE SISTEMAS]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="20" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font isBold="true" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{municipio}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="50" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="true" isUnderline="true"/>
                </textElement>
                <text><![CDATA[Certidão Positiva de Débitos]]></text>
            </staticText>
        </band>
    </title>

    <detail>
        <band height="250">
            <staticText>
                <reportElement x="0" y="10" width="100" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Nome ou Razão:]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="10" width="455" height="20"/>
                <textFieldExpression><![CDATA[$F{nomeRazao}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="30" width="100" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[CPF/CNPJ:]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="30" width="455" height="20"/>
                <textFieldExpression><![CDATA[$F{documento}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="50" width="100" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Logradouro:]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="50" width="455" height="20"/>
                <textFieldExpression><![CDATA[$F{logradouro} + ", Bairro: " + $F{bairro}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="100" width="555" height="80"/>
                <textElement textAlignment="Justified">
                    <font size="10"/>
                </textElement>
                <text><![CDATA[CERTIFICO para fins de direito, que mandando verificar os arquivos relativos aos tributos administrados pela Secretaria Municipal de Finanças, foi constatada a existência de pendência(s) em nome do contribuinte acima identificado. Fica ainda ressalvado à Fazenda Pública Municipal o direito de cobrar e inscrever em Dívida Ativa quaisquer outros débitos que vierem a ser apurados.]]></text>
            </staticText>

            <textField>
                <reportElement x="0" y="200" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font isItalic="true" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Código de Autenticidade: " + $F{codigoAutenticidade}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="40">
            <line>
                <reportElement x="0" y="0" width="555" height="1"/>
            </line>
            <staticText>
                <reportElement x="0" y="5" width="555" height="30"/>
                <textElement textAlignment="Center">
                    <font size="8"/>
                </textElement>
                <text><![CDATA[RUA SAO CRISTOVAO Nº: SN CASA, Bairro CENTRO CEP: 49.930-000 SANTARÉM/PA
tributos_nfse@agapesistemas.com.br]]></text>
            </staticText>
        </band>
    </pageFooter>
</jasperReport>