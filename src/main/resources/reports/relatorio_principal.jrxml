<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="RelatorioFrota" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="periodo" class="java.lang.String"/>
    <field name="custoMedioKm" class="java.lang.Double"/>
    <field name="kmTotal" class="java.lang.Double"/>
    <field name="viagensRealizadas" class="java.lang.Integer"/>

    <title>
        <band height="80">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center"><font size="18" isBold="true"/></textElement>
                <text><![CDATA[Relatório de Gestão de Frota]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="30" width="555" height="20"/>
                <textElement textAlignment="Center"><font size="12"/></textElement>
                <textFieldExpression><![CDATA["Período: " + $P{periodo}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <detail>
        <band height="150">
            <staticText>
                <reportElement x="0" y="10" width="200" height="20"/>
                <text><![CDATA[Custo Médio por KM (R$):]]></text>
            </staticText>
            <textField>
                <reportElement x="200" y="10" width="100" height="20"/>
                <textFieldExpression><![CDATA[$F{custoMedioKm}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="40" width="200" height="20"/>
                <text><![CDATA[Quilometragem Total (KM):]]></text>
            </staticText>
            <textField>
                <reportElement x="200" y="40" width="100" height="20"/>
                <textFieldExpression><![CDATA[$F{kmTotal}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="70" width="200" height="20"/>
                <text><![CDATA[Viagens Realizadas:]]></text>
            </staticText>
            <textField>
                <reportElement x="200" y="70" width="100" height="20"/>
                <textFieldExpression><![CDATA[$F{viagensRealizadas}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>